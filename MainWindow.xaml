<Window x:Class="NoxoGraphics.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Noxo Graphics" Width="1280" Height="780" MinWidth="900" MinHeight="620" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
 </Window.Resources>
 <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="18" Padding="16"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="NOXO" FontSize="27" FontWeight="Bold"/><TextBlock Text="GRAPHICS" Foreground="{StaticResource Accent2}" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,28"/>
   <Button Content="⌂  Dashboard" Click="Dashboard_Click"/><Button Content="◈  Packs" Click="Packs_Click"/><Button Content="✓  Installés" Click="Installed_Click"/><Button Content="⚙  Paramètres" Click="Settings_Click"/>
   </StackPanel><Border DockPanel.Dock="Bottom" Background="#0C1018" CornerRadius="12" Padding="12" Margin="0,20,0,0"><StackPanel><TextBlock Text="ÉTAT DU SYSTÈME" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="StatusText" Text="Analyse..." Margin="0,6,0,0" FontWeight="SemiBold"/></StackPanel></Border>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="20,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="34" FontWeight="Bold"/><TextBlock Text="Gère tes graphiques FiveM en quelques clics." Foreground="{StaticResource Muted}" Margin="0,4,0,20"/></StackPanel><Button Content="⚡ OPTIMISER MON PC" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource Accent}" Click="Optimize_Click"/></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Background="{StaticResource Panel}" CornerRadius="18" Padding="22" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FIVEM" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="FiveMPath" Text="Recherche de FiveM..." FontSize="17" FontWeight="SemiBold" Margin="0,6,0,4"/><TextBlock x:Name="GtaPath" Text="" Foreground="{StaticResource Muted}"/></StackPanel><Border Grid.Column="1" Background="#163A2D" CornerRadius="20" Padding="13,7"><TextBlock Text="● PRÊT" Foreground="#67E8A5" FontWeight="Bold"/></Border></Grid></Border>
    <TextBlock Text="Packs recommandés" FontSize="22" FontWeight="Bold" Margin="2,8,0,12"/><UniformGrid Columns="3"><Border Background="{StaticResource Panel}" CornerRadius="16" Padding="18" Margin="0,0,10,10"><StackPanel><TextBlock Text="🌿" FontSize="32"/><TextBlock Text="Natural Realism" FontSize="18" FontWeight="Bold" Margin="0,12,0,3"/><TextBlock Text="Équilibre qualité / FPS" Foreground="{StaticResource Muted}"/><Button Content="Installer" Margin="0,16,0,0" Click="Install_Click"/></StackPanel></Border><Border Background="{StaticResource Panel}" CornerRadius="16" Padding="18" Margin="0,0,10,10"><StackPanel><TextBlock Text="🔥" FontSize="32"/><TextBlock Text="Ultra Visual" FontSize="18" FontWeight="Bold" Margin="0,12,0,3"/><TextBlock Text="Qualité maximale" Foreground="{StaticResource Muted}"/><Button Content="Installer" Margin="0,16,0,0" Click="Install_Click"/></StackPanel></Border><Border Background="{StaticResource Panel}" CornerRadius="16" Padding="18" Margin="0,0,0,10"><StackPanel><TextBlock Text="⚡" FontSize="32"/><TextBlock Text="Performance" FontSize="18" FontWeight="Bold" Margin="0,12,0,3"/><TextBlock Text="FPS avant tout" Foreground="{StaticResource Muted}"/><Button Content="Installer" Margin="0,16,0,0" Click="Install_Click"/></StackPanel></Border></UniformGrid>
    <Border Background="#0E121A" CornerRadius="16" Padding="18" Margin="0,8,0,20"><StackPanel><TextBlock Text="Journal" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="LogText" Text="Noxo Graphics prêt." Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
   </StackPanel></ScrollViewer>
  </Grid>
 </Grid>
</Window>
